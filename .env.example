# SQLite is used by default at backend/output/job_finder.db.
# Uncomment to choose another local database:
# DATABASE_URL=sqlite:///C:/path/to/job_finder.db

# A later PostgreSQL migration only changes the driver and credentials:
# DATABASE_URL=postgresql+psycopg://job_finder:password@localhost/job_finder

# Authentication is enabled by default for the real application.
JOB_FINDER_AUTH_ENABLED=1
JOB_FINDER_SESSION_DAYS=30
# Enable only when the application is served over HTTPS:
JOB_FINDER_SECURE_COOKIES=0
